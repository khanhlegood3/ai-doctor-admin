# Consensus Engine API URL
# Default: http://127.0.0.1:8000  (FastAPI backend chạy local)
# Khi deploy production, đổi thành URL thật, ví dụ:
VITE_PUBLIC_SITE_URL=

# VITE_CONSENSUS_API_URL=https://api.your-domain.com
VITE_CONSENSUS_API_URL=
ANTHROPIC_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# LAM (Hugging Face Space), optional override — see api/lam-generate.js
LAM_HF_SPACE=
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LHM (Hugging Face Space), optional override — see api/lhm-generate.js
# Default target is now "Lingteng/LHMPP" (LHM++, aigc3d/LHM-plusplus) since
# it's actually running, unlike the original 3DAIGC/LHM (build error at time
# of writing) and the ModelScope mirror (geo-blocked to mainland China phone
# numbers only — confirmed by screenshot, don't waste time on it).
LHM_HF_SPACE=
# LHM_HF_SPACE=3DAIGC/LHM
# LHM_GRADIO_URL=  (only if you self-host your own Gradio mirror elsewhere)


# Binance Testnet
VITE_YOUR_PIMLICO_API_KEY=
VITE_PIMLICO_BUNDLER_URL=

VITE_YOUR_ALCHEMY_API_KEY=
VITE_ALCHEMY_BUNDLER_URL=

# BICONOMY_BUNDLER
# VITE_BICONOMY_BUNDLER_URL=https://bundler.biconomy.io/api/v2/97/mee_5L9XRnKWMuAqj4EbzR7F5E

VITE_AFFILIATE_CONTRACT_ADDRESS=
VITE_PAYMASTER_CONTRACT_ADDRESS=

VITE_AFFILIATE_CONTRACT_WEBHOOK_ID=
VITE_AFFILIATE_CONTRACT_WEBHOOK_URL=

VITE_PAYMASTER_CONTRACT_WEBHOOK_ID=
VITE_PAYMASTER_CONTRACT_WEBHOOK_URL=

# MORALIS
VITE_YOUR_MORALIS_API_KEY=
MORALIS_STREAM_SECRET=
