# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
dist/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc / OS generated files
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Icon?
Thumbs.db
desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# generated at predev/prebuild by scripts-copy-*.mjs (self-hosted vendor assets,
# not committed — regenerated fresh on every dev/build/deploy)
/public/wasm
/public/models
/public/vendor
# Generated by scripts-copy-mediapipe-*.mjs (predev/prebuild) -- do not
# commit copies, they're regenerated locally/in CI. thumbs_up.png (the
# one legit pre-existing tracked file in this dir) stays tracked via the
# negation rule below.
/public/src/mediapipe-khanh/*
!/public/src/mediapipe-khanh/thumbs_up.png

# typescript
*.tsbuildinfo
next-env.d.ts
