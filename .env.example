# Domain production thật của app (KHÔNG có dấu / ở cuối).
# Dùng làm nguồn DUY NHẤT cho các URL bắt buộc phải public (vd: endpoint
# webhook đăng ký với Alchemy/Moralis — xem src/lib/siteUrl.js).
# Khi đổi domain production, CHỈ CẦN sửa dòng này (và set lại trên Vercel
# Project Settings > Environment Variables), không cần sửa code.
VITE_PUBLIC_SITE_URL=https://hienmaunhanvan.com

# Consensus Engine API URL
# Default: http://127.0.0.1:8000  (FastAPI backend chạy local)
# Khi deploy production, đổi thành URL thật, ví dụ:
# VITE_CONSENSUS_API_URL=https://api.your-domain.com
VITE_CONSENSUS_API_URL=https://ai-doctor-engine.vercel.app
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_GOOGLE_CLIENT_ID=994105945304-pafrglvec32r5vb2gruuob77cp890ahc.apps.googleusercontent.com

# LAM (Hugging Face Space), optional override — see api/lam-generate.js
# LAM_HF_SPACE=3DAIGC/LAM
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
